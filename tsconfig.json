{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "playwright.config.ts",
    "test-config.ts",
    "ui-viewports.ts",
    "pages/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.ts",
    "clients/**/*.ts",
    "generators/**/*.ts",
    "fixtures/**/*.ts",
    "validators/**/*.ts"
  ]
}
