{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "playwright.config.ts",
    "test-config.ts",
    "tests/**/*.ts",
    "types/**/*.ts"
  ]
}
